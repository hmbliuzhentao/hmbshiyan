{
    email {$ACME_EMAIL}
}

(authenticated_panel) {
    encode zstd gzip
    request_body {
        max_size 110MB
    }
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}

auth.heimanbo.com {
    import authenticated_panel
}
