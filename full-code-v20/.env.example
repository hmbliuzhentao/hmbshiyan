# V2.0 独立环境。所有密码/密钥必须自行生成，禁止提交到 GitHub。
POSTGRES_DB=heimanbo_v20
POSTGRES_USER=heimanbo_v20
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@heimanbo.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_16_CHARS_MINIMUM
ACME_EMAIL=ops@heimanbo.com

ALLOWED_ORIGINS=https://auth.heimanbo.com,https://work.heimanbo.com,https://video.heimanbo.com,https://merchant.heimanbo.com,https://system.heimanbo.com,https://test-v2.heimanbo.com,https://api.heimanbo.com,https://media.heimanbo.com

# Email OTP (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# SMS provider adapter. Endpoint must accept JSON {phone,code,template_id,ttl_minutes}
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_TEMPLATE_ID=

# WeChat Open Platform website application
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Existing Caddy Docker network (verify on server before install)
PROXY_NETWORK=heimanbo-test_app
